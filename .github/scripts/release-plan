#!/usr/bin/env bash
#
# Decides what the deploy workflow does with HEAD and writes the answer to
# $GITHUB_OUTPUT (stdout when run by hand):
#
#   release  true when a deployable input changed since the last vX.Y.Z tag:
#            build, deploy, then tag `version`
#   deploy   true when something must reach production: a release, or a
#            released version named in INPUT_VERSION (redeploy, no build)
#   version  the semver to build, deploy or redeploy
#
# The bump follows Conventional Commits through git-cliff (cliff.toml). A
# change git-cliff does not bump (chore, non-conventional) still takes the
# next patch, because a changed image must never reuse a version.

set -u

# install.sh ships attached to each release, so a change to it alone
# releases too.
readonly deployable=(
	crates migrations
	Cargo.toml Cargo.lock Dockerfile .dockerignore
	config .kamal Gemfile Gemfile.lock
	install.sh
)
readonly semver='^[0-9]+\.[0-9]+\.[0-9]+$'

out=${GITHUB_OUTPUT:-/dev/stdout}

die() {
	printf 'release-plan: %s\n' "$*" >&2
	exit 1
}

emit() {
	printf 'release=%s\ndeploy=%s\nversion=%s\n' "$1" "$2" "$3" >>"$out"
	printf 'release-plan: release=%s deploy=%s version=%s\n' "$1" "$2" "$3" >&2
}

if [[ -n ${INPUT_VERSION:-} ]]; then
	version=${INPUT_VERSION#v}
	[[ $version =~ $semver ]] || die "not a version: $INPUT_VERSION"
	git rev-parse -q --verify "refs/tags/v$version" >/dev/null ||
		die "v$version was never released"
	emit false true "$version"
	exit 0
fi

last=$(git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null)

if [[ -n $last ]]; then
	git diff --quiet "$last" HEAD -- "${deployable[@]}"
	case $? in
	0)
		emit false false "${last#v}"
		exit 0
		;;
	1) ;;
	*) die "git diff against $last failed" ;;
	esac
fi

next=$(git cliff --bumped-version) || die "git-cliff could not compute the next version"
next=${next#v}
if [[ -n $last && $next == "${last#v}" ]]; then
	IFS=. read -r major minor patch <<<"$next"
	next=$major.$minor.$((patch + 1))
fi
[[ $next =~ $semver ]] || die "git-cliff returned '$next'"

emit true true "$next"
